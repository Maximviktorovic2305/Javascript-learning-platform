generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  credentialVersion Int @default(0)
  timezone String @default("Asia/Vladivostok")
  timezoneAuto Boolean @default(true)
  dailyGoal Int @default(50)
  createdAt DateTime @default(now())
  termsAcceptedAt DateTime?
  dataConsentAt DateTime?
  legalVersion String?
  sessions Session[]
  awards Award[]
  attempts Attempt[]
  submissions Submission[]
}

model Session {
  tokenHash String @id
  userId String
  credentialVersion Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}

model Award {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  key String
  xp Int
  createdAt DateTime @default(now())
  @@unique([userId, key])
  @@index([userId, createdAt])
}

model Attempt {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetId String
  kind String
  score Int
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Submission {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  url String
  status String @default("submitted")
  createdAt DateTime @default(now())
  @@unique([userId, projectId])
}
