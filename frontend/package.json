{
  "name": "script-lab-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "nuxt dev --port 3020 --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "pretest": "node --test vendor/deepmerge/security-check.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lucide/vue": "1.61.0",
    "codemirror": "6.0.2",
    "nuxt": "4.6.2",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.1.0",
    "deepmerge": "file:vendor/deepmerge"
  },
  "overrides": {
    "deepmerge": "$deepmerge"
  }
}
